# Copy to supabase/.env.firebase.local (gitignored) and fill from the service account JSON:
#   project_id          -> FIREBASE_PROJECT_ID
#   client_email        -> FIREBASE_CLIENT_EMAIL
#   private_key         -> FIREBASE_PRIVATE_KEY (keep PEM newlines inside the quoted value, or use one line with \n)
#
# Then: supabase secrets set --env-file supabase/.env.firebase.local
#
# Or run: node supabase/scripts/set-firebase-secrets-from-sa.mjs /path/to/serviceAccount.json

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
