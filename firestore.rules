rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOrganizer(data) {
      return isSignedIn() && data.organizerId == request.auth.uid;
    }

    function isTeamCaptain(teamData) {
      return isSignedIn() &&
        teamData != null &&
        teamData.captainId == request.auth.uid;
    }

    function isTeamStaff(teamData) {
      return isSignedIn() &&
        teamData != null &&
        (
          teamData.captainId == request.auth.uid ||
          (
            teamData.viceCaptainIds != null &&
            teamData.viceCaptainIds.hasAny([request.auth.uid])
          )
        );
    }

    function canManageTeam(teamId) {
      return isTeamStaff(
        get(/databases/$(database)/documents/teams/$(teamId)).data
      );
    }

    function getMatchData(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    function rosterHas(key, matchData) {
      return matchData.teamRosterStatus != null &&
        matchData.teamRosterStatus[key] != null &&
        matchData.teamRosterStatus[key][request.auth.uid] != null;
    }

    function rosterTeamKey(matchData) {
      return rosterHas('teamA', matchData)
        ? 'teamA'
        : rosterHas('teamB', matchData)
          ? 'teamB'
          : '';
    }

    function rosterStatusChangedCorrectly(matchData) {
      let key = rosterTeamKey(matchData);
      return key != '' &&
        request.resource.data.teamRosterStatus[key] != null &&
        matchData.teamRosterStatus[key].diff(
          request.resource.data.teamRosterStatus[key]
        ).changedKeys().hasOnly([request.auth.uid]);
    }

    function rosterSelectionKeysAllowed(matchData) {
      return request.resource.data.diff(matchData).changedKeys().hasOnly([
        'teamRosters',
        'teamRosterStatus',
        'teamAStatus',
        'teamBStatus',
        'teamA',
        'teamB',
        'teamAId',
        'teamBId',
        'updatedAt'
      ]);
    }

    function teamRosterSelectionChanged(teamKey, matchData) {
      let oldRosters = matchData.teamRosters == null ? {} : matchData.teamRosters;
      let newRosters = request.resource.data.teamRosters == null
        ? {}
        : request.resource.data.teamRosters;
      let oldStatuses = matchData.teamRosterStatus == null
        ? {}
        : matchData.teamRosterStatus;
      let newStatuses = request.resource.data.teamRosterStatus == null
        ? {}
        : request.resource.data.teamRosterStatus;
      let statusField = teamKey == 'teamA' ? 'teamAStatus' : 'teamBStatus';
      let teamField = teamKey == 'teamA' ? 'teamA' : 'teamB';
      let teamIdField = teamKey == 'teamA' ? 'teamAId' : 'teamBId';
      return newRosters[teamKey] != oldRosters[teamKey] ||
        newStatuses[teamKey] != oldStatuses[teamKey] ||
        request.resource.data[statusField] != matchData[statusField] ||
        request.resource.data[teamField] != matchData[teamField] ||
        request.resource.data[teamIdField] != matchData[teamIdField];
    }

    function managesRosterTeam(teamKey, matchData) {
      let teamIdField = teamKey == 'teamA' ? 'teamAId' : 'teamBId';
      let existingId = matchData[teamIdField];
      let requestedId = request.resource.data[teamIdField];
      let targetId = existingId != null ? existingId : requestedId;
      return targetId != null && canManageTeam(targetId);
    }

    function participantsChangeBySelf(matchData) {
      let newParticipants = request.resource.data.participants;
      let oldParticipants = matchData.participants;
      return newParticipants == oldParticipants ||
        (
          newParticipants.size() == oldParticipants.size() + 1 &&
          newParticipants.hasAll(oldParticipants) &&
          newParticipants.hasAny([request.auth.uid])
        ) ||
        (
          newParticipants.size() == oldParticipants.size() - 1 &&
          oldParticipants.hasAll(newParticipants) &&
          oldParticipants.hasAny([request.auth.uid]) &&
          !newParticipants.hasAny([request.auth.uid])
        );
    }

    function rosterUpdateKeysAllowed() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'teamRosterStatus',
        'participants',
        'updatedAt',
        'teamAStatus',
        'teamBStatus',
        'teamsReadyNotified',
        'teamsReadyNotifiedAt'
      ]);
    }

    function canRatePlayer(matchId, raterId, playerId) {
      let matchData = getMatchData(matchId);
      return matchData != null &&
        matchData.participants.hasAll([raterId, playerId]);
    }

    function isSelfJoiningTeam(teamData) {
      return isSignedIn() &&
        teamData != null &&
        teamData.memberIds != null &&
        !teamData.memberIds.hasAny([request.auth.uid]) &&
        request.resource.data.memberIds.size() == teamData.memberIds.size() + 1 &&
        request.resource.data.memberIds.hasAll(teamData.memberIds) &&
        request.resource.data.memberIds.hasAny([request.auth.uid]) &&
        request.resource.data.diff(teamData).changedKeys().hasOnly(['memberIds','updatedAt']);
    }

        match /matches/{matchId} {
      allow read: if true;

      // Створення дозволено лише авторизованим
      allow create: if isSignedIn();

            // організатор або адмін можуть оновлювати будь-які поля
      allow update: if isSignedIn() && (
        resource.data.organizerId == request.auth.uid ||
        request.resource.data.organizerId == request.auth.uid ||
        request.auth.token.admin == true
      );

      // Учасник може "вийти" з відкритого матчу (participants зменшується на 1)
      allow update, delete: if
        isSignedIn() &&
        resource.data.status == 'open' &&
        request.resource.data.participants.size() ==
          resource.data.participants.size() - 1;

      // Організатор: старт/фініш/автобаланс/заявки
            allow update: if isOrganizer(resource.data) && (
        // старт
        (request.resource.data.status == 'inProgress' && resource.data.status == 'open') ||
        // фініш (обовʼязково ставимо finishedAt)
        (request.resource.data.status == 'finished' && resource.data.status == 'inProgress' && request.resource.data.keys().hasAny(['finishedAt'])) ||
        // скасування (можна скасувати з open/full/inProgress)
        (request.resource.data.status == 'cancelled' && (
          resource.data.status == 'open' ||
          resource.data.status == 'full' ||
          resource.data.status == 'inProgress'
        )) ||
        // автобаланс (оновлення teamA/teamB)
        (request.resource.data.keys().hasAny(['teamA', 'teamB'])) ||
        // робота із заявками/учасниками
        (request.resource.data.keys().hasAny(['pendingApplications', 'participants']))
      );

            // дозволити оновлювати таблицю підсумків
      allow update: if isSignedIn() &&
        request.resource.data.keys().hasAny(['multiTeamStats']) &&
        (resource.data.organizerId == request.auth.uid || request.auth.token.admin == true);

      match /fixtures/{fixtureId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          resource.data.organizerId == request.auth.uid ||
          request.auth.token.admin == true
        );
      }

      // Учасники можуть приєднуватися до відкритих матчів
      allow update: if isSignedIn() && 
        resource.data.status == 'open' &&
        request.resource.data.status == 'open' &&
        request.resource.data.participants.size() == resource.data.participants.size() + 1 &&
        request.resource.data.participants.hasAll(resource.data.participants) &&
        request.resource.data.participants.hasAny([request.auth.uid]);

      // Учасники можуть залишати матчі
      allow update: if isSignedIn() && 
        resource.data.status == 'open' &&
        request.resource.data.status == 'open' &&
        request.resource.data.participants.size() == resource.data.participants.size() - 1 &&
        resource.data.participants.hasAll(request.resource.data.participants) &&
        resource.data.participants.hasAny([request.auth.uid]) &&
        !request.resource.data.participants.hasAny([request.auth.uid]);

      // Підтвердження складу командних матчів
      allow update: if isSignedIn() &&
        rosterStatusChangedCorrectly(resource.data) &&
        participantsChangeBySelf(resource.data) &&
        rosterUpdateKeysAllowed();

      // Капітани команд можуть обирати склад для свого боку
      allow update: if isSignedIn() &&
        rosterSelectionKeysAllowed(resource.data) &&
        (
          (
            teamRosterSelectionChanged('teamA', resource.data) &&
            !teamRosterSelectionChanged('teamB', resource.data) &&
            managesRosterTeam('teamA', resource.data)
          ) ||
          (
            teamRosterSelectionChanged('teamB', resource.data) &&
            !teamRosterSelectionChanged('teamA', resource.data) &&
            managesRosterTeam('teamB', resource.data)
          )
        );
              
      // Користувачі можуть подавати заявки на матчі
      allow update: if isSignedIn() && 
        resource.data.status == 'open' &&
        request.resource.data.status == 'open' &&
        request.resource.data.keys().hasAny(['pendingApplications']) &&
        request.resource.data.pendingApplications.size() == resource.data.pendingApplications.size() + 1 &&
        request.resource.data.pendingApplications.hasAll(resource.data.pendingApplications) &&
        request.resource.data.pendingApplications.hasAny([request.auth.uid]) &&
        !resource.data.participants.hasAny([request.auth.uid]) &&
        !resource.data.pendingApplications.hasAny([request.auth.uid]) &&
        !resource.data.rejectedApplications.hasAny([request.auth.uid]);
      
    
                  
      // Оцінки гравців після матчу (підколекція)
      match /playerRatings/{docId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn() &&
          request.resource.data.ratedBy == request.auth.uid &&
          request.resource.data.playerId != request.auth.uid &&
          canRatePlayer(matchId, request.auth.uid, request.resource.data.playerId) &&
          !exists(/databases/$(database)/documents/matches/$(matchId)/playerRatings/$(docId));
      }
        match /fixtures/{fixtureId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/matches/$(matchId)).data.organizerId == request.auth.uid ||
          request.auth.token.admin == true
        );
      }
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.captainId == request.auth.uid &&
        request.resource.data.memberIds.size() == 1 &&
        request.resource.data.memberIds.hasOnly([request.auth.uid]);
      allow update: if
        isTeamStaff(resource.data) ||
        request.auth.token.admin == true ||
        isSelfJoiningTeam(resource.data);
      allow delete: if
        isTeamCaptain(resource.data) ||
        request.auth.token.admin == true;
    }

    match /teamInvites/{inviteId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.invitedBy == request.auth.uid ||
        canManageTeam(resource.data.teamId)
      );
      allow create: if isSignedIn() &&
        request.resource.data.invitedBy == request.auth.uid &&
        canManageTeam(request.resource.data.teamId);
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.invitedBy == request.auth.uid ||
        canManageTeam(resource.data.teamId)
      );
    }

    match /teamJoinRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        canManageTeam(resource.data.teamId)
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isSignedIn() &&
        canManageTeam(resource.data.teamId);
    }

    match /teamMatchRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        (
          canManageTeam(request.resource.data.teamId) ||
          canManageTeam(request.resource.data.opponentTeamId)
        );
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy ||
        canManageTeam(resource.data.teamId) ||
        (
          resource.data.keys().hasAny(['opponentTeamId']) &&
          canManageTeam(resource.data.opponentTeamId)
        )
      );
    }

    match /teamStats/{teamId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

        match /users/{uid} {
      allow read: if isSignedIn();
      // During development allow any signed-in user to update user fields
      allow update: if isSignedIn();
      allow create, delete: if isSignedIn(); // Змінено для розробки
      
      // Allow reads to user subcollections (friends, etc.) for signed-in users
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn(); // Додано для розробки
      }
    }
    // Videos: anyone can read, only owner can create/update/delete
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Allow owner to update/delete. Also allow safe counter updates by any signed-in user
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['likes','commentsCount','views'])
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Comments under video
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
      }

      // Likes under video: voter writes their own like doc
      match /likes/{likeUserId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && likeUserId == request.auth.uid;
      }

      // Votes under video: voter writes their own vote doc
      match /votes/{voteUserId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && voteUserId == request.auth.uid;
      }
    }

    // Challenges and nested collections
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      // Allow updates during development for signed-in users (participants, votes, etc.)
      allow update: if isSignedIn();

      // Submissions within a challenge
      match /submissions/{submissionId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        // Allow rating/thumbnail updates by signed-in users (client computes averages)
        allow update: if isSignedIn();
      }

      // Votes within a challenge
      match /votes/{voteId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
      }
    }

    // Transactions: user can read own and create own
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Rating history: user can read own; any signed-in user can create (votes affect authors)
    match /rating_history/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Friend requests: participants may read/update; only requester can create
    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid && request.resource.data.toUserId != request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromUserId == request.auth.uid
      );
    }

    // Notifications and queue
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /pushNotifications/{id} {
      allow create: if isSignedIn();
      allow read: if false; // queue-only
    }

    // Badges: public read; writes by signed-in (for store/admin and initialization)
    match /badges/{badgeId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // Subscriptions: relaxed for dev (read/create/update by signed-in)
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }
     // Test data: allow creation during development
    match /test_matches/{matchId} {
      allow read, write: if isSignedIn();
    }
    
    match /test_users/{userId} {
      allow read, write: if isSignedIn();
    }
  }
}