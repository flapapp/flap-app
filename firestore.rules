rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOrganizer(data) {
      return isSignedIn() && data.organizerId == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if true;

      // Створення дозволено лише авторизованим
      allow create: if isSignedIn();

      // Учасник може "вийти" з відкритого матчу (participants зменшується на 1)
      allow update, delete: if
        isSignedIn() &&
        resource.data.status == 'open' &&
        request.resource.data.participants.size() ==
          resource.data.participants.size() - 1;

      // Організатор: старт/фініш/автобаланс/заявки
      allow update: if isOrganizer(resource.data) && (
        // старт
        (request.resource.data.status == 'inProgress' && resource.data.status == 'open') ||
        // фініш (обовʼязково ставимо finishedAt)
        (request.resource.data.status == 'finished' && request.resource.data.keys().hasAny(['finishedAt'])) ||
        // автобаланс (оновлення teamA/teamB)
        (request.resource.data.keys().hasAny(['teamA', 'teamB'])) ||
        // робота із заявками/учасниками
        (request.resource.data.keys().hasAny(['pendingApplications', 'participants']))
      );
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}